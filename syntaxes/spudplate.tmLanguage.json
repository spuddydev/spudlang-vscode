{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "spudlang",
  "scopeName": "source.spudlang",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-interpolated" },
    { "include": "#string-plain" },
    { "include": "#numeric" },
    { "include": "#operator" },
    { "include": "#keyword-control" },
    { "include": "#keyword-command" },
    { "include": "#keyword-modifier" },
    { "include": "#type" },
    { "include": "#boolean" },
    { "include": "#builtin-function" },
    { "include": "#variable" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.spudlang",
      "match": "#.*$"
    },

    "string-interpolated": {
      "name": "string.quoted.double.spudlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.spudlang",
          "match": "\\\\[nrt\\\\\"{}]"
        },
        {
          "name": "meta.interpolation.spudlang",
          "match": "\\{[^}]*\\}",
          "captures": {
            "0": { "name": "variable.other.interpolated.spudlang" }
          }
        }
      ]
    },

    "string-plain": {
      "name": "string.quoted.double.spudlang",
      "match": "\"[^\"]*\""
    },

    "numeric": {
      "name": "constant.numeric.spudlang",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },

    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.spudlang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.spudlang",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.operator.assignment.spudlang",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.spudlang",
          "match": "[+\\-*/]"
        }
      ]
    },

    "keyword-control": {
      "name": "keyword.control.spudlang",
      "match": "\\b(when|repeat|as|end)\\b"
    },

    "keyword-command": {
      "name": "keyword.other.command.spudlang",
      "match": "\\b(ask|let|mkdir|file|from|content|mode|verbatim|append|not)\\b"
    },

    "keyword-modifier": {
      "name": "storage.modifier.spudlang",
      "match": "\\b(required)\\b"
    },

    "type": {
      "name": "support.type.spudlang",
      "match": "\\b(string|int|bool)\\b"
    },

    "boolean": {
      "name": "constant.language.boolean.spudlang",
      "match": "\\b(true|false)\\b"
    },

    "builtin-function": {
      "name": "support.function.builtin.spudlang",
      "match": "\\b(lower|upper|trim)\\b(?=\\s*\\()"
    },

    "variable": {
      "name": "variable.other.spudlang",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
