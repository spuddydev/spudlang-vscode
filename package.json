{
  "name": "spudlang",
  "displayName": "spudlang",
  "description": "Syntax highlighting and IntelliSense for spudlang, the spudplate templating language",
  "version": "0.2.0",
  "publisher": "spuddydev",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:spudlang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "spudlang",
        "aliases": [
          "spudlang",
          "spudplate"
        ],
        "extensions": [
          ".spud",
          ".spudplate"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spudlang",
        "scopeName": "source.spudlang",
        "path": "./syntaxes/spudplate.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
